# 1. 标准化变量
library(sfdep)
library(spdep)
# kNN (k=4) 邻接
coords <- st_coordinates(st_centroid(st_geometry(g_panel)))
nb <- knn2nb(knearneigh(coords, k = 4))
# 有效观测（两变量都不缺）
valid <- !is.na(g_panel$co2_per_1000p) & !is.na(g_panel$pct_efg)
# 子集 nb 与变量（注意：subset.nb 需要逻辑向量）
nb_sub <- spdep::subset.nb(nb, subset = valid)
# 权重（行标准化 W）
wt_sub <- sfdep::st_weights(nb_sub, style = "W")
# 标准化后的变量（仅对有效单元）
y_std <- scale(g_panel$co2_per_1000p[valid])[,1]
x_std <- scale(g_panel$pct_efg[valid])[,1]
# —— 计算双变量 LISA（新版接口必须 nb+wt 同时给）——
lisa <- sfdep::local_moran_bv(
x  = y_std,           # CO2
y  = x_std,           # EPC
nb = nb_sub,
wt = wt_sub,
alternative = "two.sided"
)
lisa <- sfdep::local_moran_bv(
x  = y_std,           # CO2
y  = x_std,           # EPC
nb = nb_sub,
wt = wt_sub,
)
# 生成聚类标签（High/Low by 0）
lw_sub <- spdep::nb2listw(nb_sub, style = "W")
lag_epc <- spdep::lag.listw(lw_sub, x_std)
cluster_sub <- dplyr::case_when(
lisa$p_ii < 0.05 & y_std >= 0 & lag_epc >= 0 ~ "High-High",
lisa$p_ii < 0.05 & y_std <  0 & lag_epc <  0 ~ "Low-Low",
lisa$p_ii < 0.05 & y_std >= 0 & lag_epc <  0 ~ "High-Low",
lisa$p_ii < 0.05 & y_std <  0 & lag_epc >= 0 ~ "Low-High",
TRUE ~ "Not significant"
)
# 写回到完整 g_panel（无效位置填 NA）
g_panel$cluster <- NA_character_
g_panel$cluster[valid] <- cluster_sub
# --- 前置：如你还没这些对象，先确保它们存在 -------------------------------
library(sf); library(spdep); library(sfdep); library(dplyr); library(tidyr); library(tmap)
set.seed(2023)
# kNN(k=4) 邻接 + 有效样本
coords <- st_coordinates(st_centroid(st_geometry(g_panel)))
nb_all <- knn2nb(knearneigh(coords, k = 4))
valid  <- !is.na(g_panel$co2_per_1000p) & !is.na(g_panel$pct_efg)
nb_sub <- spdep::subset.nb(nb_all, subset = valid)
wt_sub <- sfdep::st_weights(nb_sub, style = "W")
# 标准化变量（仅对有效单元）
y_std <- scale(g_panel$co2_per_1000p[valid])[,1]   # CO2
x_std <- scale(g_panel$pct_efg[valid])[,1]         # EPC
# 双变量 LISA
lisa <- sfdep::local_moran_bv(x = y_std, y = x_std, nb = nb_sub, wt = wt_sub)
# 邻域 EPC 的标准化滞后
lw_sub  <- spdep::nb2listw(nb_sub, style = "W")
lag_epc <- spdep::lag.listw(lw_sub, x_std, zero.policy = TRUE)
# --- 1) 诊断：到底是“真的都不显著”，还是“阈值太严” ------------------------
p_raw <- lisa$p_ii
p_bh  <- p.adjust(p_raw, method = "BH")
cat("有效 LAD 数：", length(y_std), "\n")
cat("原始p<0.05 的数量：", sum(p_raw < 0.05, na.rm = TRUE), "\n")
cat("原始p<0.10 的数量：", sum(p_raw < 0.10, na.rm = TRUE), "\n")
cat("BH校正p<0.05 的数量：", sum(p_bh < 0.05, na.rm = TRUE), "\n")
cat("最小原始p：", min(p_raw, na.rm = TRUE), "；最小BH p：", min(p_bh, na.rm = TRUE), "\n")
# --- 2) 三种门槛下的聚类结果：BH@0.05 / raw p@0.05 / raw p@0.10 -------------
mk_cluster <- function(p_use, alpha = 0.05) {
sig <- !is.na(p_use) & (p_use < alpha)
dplyr::case_when(
sig & y_std >= 0 & lag_epc >= 0 ~ "High-High",
sig & y_std <  0 & lag_epc <  0 ~ "Low-Low",
sig & y_std >= 0 & lag_epc <  0 ~ "High-Low",
sig & y_std <  0 & lag_epc >= 0 ~ "Low-High",
TRUE ~ "Not significant"
)
}
cluster_bh_005   <- mk_cluster(p_bh,  alpha = 0.05)
cluster_raw_005  <- mk_cluster(p_raw, alpha = 0.05)
cluster_raw_010  <- mk_cluster(p_raw, alpha = 0.10)
# 写回到完整 g_panel（无效位置填 NA）
g_panel$cluster_bh_005  <- NA_character_; g_panel$cluster_bh_005 [valid] <- cluster_bh_005
# 必要包
library(sf)
library(spdep)
library(dplyr)
library(tmap)
set.seed(2023)
# 0) 前提：g_panel 已包含 geometry、co2_per_1000p、pct_efg
stopifnot(inherits(g_panel, "sf"),
"co2_per_1000p" %in% names(g_panel),
"pct_efg" %in% names(g_panel))
# 1) kNN(k=4) 权重（对所有单元构建）
coords <- st_coordinates(st_centroid(st_geometry(g_panel)))
nb_all <- knn2nb(knearneigh(coords, k = 6))
lw_all <- nb2listw(nb_all, style = "W", zero.policy = TRUE)
# 2) 只在有效 LAD 上统计（两变量都非 NA）
valid <- !is.na(g_panel$co2_per_1000p) & !is.na(g_panel$pct_efg)
if (!any(valid)) stop("No valid LADs for analysis.")
nb_sub <- spdep::subset.nb(nb_all, subset = valid)
lw_sub <- nb2listw(nb_sub, style = "W", zero.policy = TRUE)
# 3) 标准化变量（仅对有效 LAD）
y <- scale(g_panel$co2_per_1000p[valid])[, 1]  # CO2 (z-score)
x <- scale(g_panel$pct_efg[valid])[, 1]        # EPC (z-score)
# 4) 局部双变量 Moran：I_i = z(CO2)_i * sum_j w_ij * z(EPC)_j
Wyx   <- lag.listw(lw_sub, x, zero.policy = TRUE)
Ii    <- y * Wyx
# 5) Monte Carlo 置换检验（对 x 置换）
nsim <- 999
ge_count <- integer(length(y))
for (s in 1:nsim) {
x_perm  <- sample(x)  # 仅在有效 LAD 内置换
Wyx_p   <- lag.listw(lw_sub, x_perm, zero.policy = TRUE)
Ii_perm <- y * Wyx_p
ge_count <- ge_count + as.integer(abs(Ii_perm) >= abs(Ii))
}
p_raw <- (ge_count + 1) / (nsim + 1)
p_bh  <- p.adjust(p_raw, method = "BH")
# 6) 聚类分类（按 y 与 lag(x) 的正负 + p_BH<0.05）
lag_epc <- Wyx
co2_hilo <- ifelse(y >= 0, "High", "Low")
lag_hilo <- ifelse(lag_epc >= 0, "High", "Low")
cluster_sub <- ifelse(p_bh < 0.05 & co2_hilo=="High" & lag_hilo=="High", "High-High",
ifelse(p_bh < 0.05 & co2_hilo=="Low"  & lag_hilo=="Low",  "Low-Low",
ifelse(p_bh < 0.05 & co2_hilo=="High" & lag_hilo=="Low",  "High-Low",
ifelse(p_bh < 0.05 & co2_hilo=="Low"  & lag_hilo=="High", "Low-High",
"Not significant"))))
# 7) 回写到完整 g_panel（无效置 NA）
g_panel$Ii_bv   <- NA_real_
g_panel$p_bv    <- NA_real_
g_panel$p_bv_bh <- NA_real_
g_panel$cluster <- NA_character_
g_panel$Ii_bv  [valid] <- Ii
g_panel$p_bv   [valid] <- p_raw
g_panel$p_bv_bh[valid] <- p_bh
g_panel$cluster[valid] <- cluster_sub
# 8) 快速可视化
tmap_mode("plot")
pal <- c("High-High"="#b2182b","Low-Low"="#2166ac",
"High-Low"="#ef8a62","Low-High"="#67a9cf",
"Not significant"="grey85")
tm_shape(g_panel) +
tm_fill("cluster", palette = pal,
title = "Bivariate LISA: CO₂ vs lag(EPC)\n(p adj. BH < 0.05)") +
tm_borders(col = "grey40", lwd = 0.3) +
tm_layout(legend.outside = TRUE)
View(g)
View(g_panel)
urbanity_panel <- g |>
filter(!is.na(.data[[co2_var]]), !is.na(.data[[urban_var]]))
urbanity_panel <- g |>
filter(!is.na(.data[[co2_per_1000p]]), !is.na(.data[[urbanity]]))
urbanity_panel <- g |>
filter(!is.na(.data[[co2_per_1000p]]), !is.na(.data[[urbanity]]))
View(g)
urbanity_panel <- g_panel |>
filter(!is.na(.data[[co2_per_1000p]]), !is.na(.data[[urbanity]]))
urbanity_panel <- g_panel |>
filter(!is.na(.data[[co2_per_1000p]]), !is.na(.data[[urbanity]]))
library(sf)
library(dplyr)
library(spdep)
library(sfdep)
library(tmap)
bv_lisa <- function(g_panel, x_var = "urbanity", y_var = "co2_per_1000p",
k = 4, nsim = 999, alpha = 0.05,
title = "Bivariate LISA: Urbanity vs lag(CO\u2082)",
seed = 42) {
stopifnot(inherits(g, "sf"))
stopifnot(all(c(x_var, y_var) %in% names(g)))
set.seed(seed)
g_panel <- g_panel |> st_make_valid() |>
filter(!is.na(.data[[x_var]]), !is.na(.data[[y_var]]))
# 1) kNN 权重（k=4）
nb <- sfdep::st_knn(g_panel, k = k)
wt <- sfdep::st_weights(nb, style = "W", allow_zero = TRUE)
listw <- spdep::nb2listw(nb, style = "W", zero.policy = TRUE)
# 2) 标准化 & 空间滞后（注意：双变量 → 滞后取 y）
zx <- as.numeric(scale(g_panel[[x_var]]))
zy <- as.numeric(scale(g_panel[[y_var]]))  # z(y) = z(CO2)
lag_zy <- spdep::lag.listw(listw, zy, zero.policy = TRUE)
n  <- nrow(g_panel); S0 <- spdep::Szero(listw)
I_obs <- (n / S0) * sum(zx * lag_zy)
I_perm <- replicate(nsim, {
zy_perm <- sample(zy, replace = FALSE)
(n / S0) * sum(zx * spdep::lag.listw(listw, zy_perm, zero.policy = TRUE))
})
p_perm <- (sum(abs(I_perm) >= abs(I_obs)) + 1) / (nsim + 1)
# 4) Local bivariate LISA（sfdep）
lisa <- sfdep::local_moran_bv(x = zx, y = zy, nb = nb, wt = wt, nsim = nsim)
# 兼容不同版本列名：优先用 p_sim，其次匹配包含 "sim" 的 p 列
pcol <- intersect(c("p_sim","p_ii_sim","p_value_sim","p_folded_sim"), names(lisa))
if (length(pcol) == 0) stop("local_moran_bv 输出中未找到模拟 p 值列。")
p_sim <- lisa[[pcol[1]]]
Ii <- if ("ii" %in% names(lisa)) lisa$ii else lisa[[1]]
# 5) BH(FDR) 多重校正 + 分型（象限基于 z(x) 与 lag(z(y))）
p_bh <- p.adjust(p_sim, method = "BH")
cls  <- rep("Not significant", length(zx))
sig  <- p_bh < alpha
cls[zx > 0 & lag_zy > 0 & sig] <- "High–High"
cls[zx < 0 & lag_zy < 0 & sig] <- "Low–Low"
cls[zx > 0 & lag_zy < 0 & sig] <- "High–Low"
cls[zx < 0 & lag_zy > 0 & sig] <- "Low–High"
cls <- factor(cls, levels = c("High–High","Low–Low","High–Low","Low–High","Not significant"))
# ========= 函数：Bivariate LISA（x = CO2, y = Urbanity） =========
bv_lisa <- function(g_panel, x_var = "urbanity", y_var = "co2_per_1000p",
k = 4, nsim = 999, alpha = 0.05,
title = "Bivariate LISA: Urbanity vs lag(CO\u2082)",
seed = 42) {
stopifnot(inherits(g_panel, "sf"))
stopifnot(all(c(x_var, y_var) %in% names(g)))
set.seed(seed)
urbanity_panel <- g_panel |> st_make_valid() |>
filter(!is.na(.data[[x_var]]), !is.na(.data[[y_var]]))
# 1) kNN 权重（k=4）
nb <- sfdep::st_knn(urbanity_panel, k = k)
wt <- sfdep::st_weights(nb, style = "W", allow_zero = TRUE)
listw <- spdep::nb2listw(nb, style = "W", zero.policy = TRUE)
# 2) 标准化 & 空间滞后（注意：双变量 → 滞后取 y）
zx <- as.numeric(scale(urbanity_panel[[x_var]]))
zy <- as.numeric(scale(urbanity_panel[[y_var]]))  # z(y) = z(CO2)
lag_zy <- spdep::lag.listw(listw, zy, zero.policy = TRUE)
# 3) Global bivariate Moran's I + 置换检验
n  <- nrow(g_panel); S0 <- spdep::Szero(listw)
I_obs <- (n / S0) * sum(zx * lag_zy)
I_perm <- replicate(nsim, {
zy_perm <- sample(zy, replace = FALSE)
(n / S0) * sum(zx * spdep::lag.listw(listw, zy_perm, zero.policy = TRUE))
})
p_perm <- (sum(abs(I_perm) >= abs(I_obs)) + 1) / (nsim + 1)
# 4) Local bivariate LISA（sfdep）
lisa <- sfdep::local_moran_bv(x = zx, y = zy, nb = nb, wt = wt, nsim = nsim)
# 兼容不同版本列名：优先用 p_sim，其次匹配包含 "sim" 的 p 列
pcol <- intersect(c("p_sim","p_ii_sim","p_value_sim","p_folded_sim"), names(lisa))
if (length(pcol) == 0) stop("local_moran_bv 输出中未找到模拟 p 值列。")
p_sim <- lisa[[pcol[1]]]
Ii <- if ("ii" %in% names(lisa)) lisa$ii else lisa[[1]]
# 5) BH(FDR) 多重校正 + 分型（象限基于 z(x) 与 lag(z(y))）
p_bh <- p.adjust(p_sim, method = "BH")
cls  <- rep("Not significant", length(zx))
sig  <- p_bh < alpha
cls[zx > 0 & lag_zy > 0 & sig] <- "High–High"
cls[zx < 0 & lag_zy < 0 & sig] <- "Low–Low"
cls[zx > 0 & lag_zy < 0 & sig] <- "High–Low"
cls[zx < 0 & lag_zy > 0 & sig] <- "Low–High"
cls <- factor(cls, levels = c("High–High","Low–Low","High–Low","Low–High","Not significant"))
# 6) 写回 sf
urbanity_panel$Z_x        <- zx
urbanity_panel$LagZ_y     <- lag_zy
urbanity_panel$Ii_bv      <- Ii
urbanity_panel$p_sim_bv   <- p_sim
urbanity_panel$p_bh_bv    <- p_bh
urbanity_panel$LISA_bv    <- cls
summary_tbl <- urbanity_panel |> st_drop_geometry() |>
count(LISA_bv, sig = ifelse(p_bh_bv < alpha, paste0("BH<", alpha), "ns")) |>
arrange(desc(sig), LISA_bv)
# 8) 地图
pal <- c("High–High"="#b2182b","Low–Low"="#2166ac",
"High–Low"="#ef8a62","Low–High"="#67a9cf","Not significant"="grey85")
tmap_mode("plot")
map <- tm_shape(urbanity_panel) +
tm_fill("LISA_bv", palette = pal, title = paste0(title,"\n(FDR BH < ", alpha, ")"),
legend.is.portrait = TRUE) +
tm_borders(col = "grey40", lwd = 0.3) +
tm_layout(frame = FALSE, legend.outside = TRUE, legend.outside.position = "right")
# 打印全局统计
cat("\nGlobal *bivariate* Moran's I:\n")
cat(sprintf("- I_xy = %.3f, perm p = %.4f (nsim = %d)\n", I_obs, p_perm, nsim))
invisible(list(
enriched_sf = urbanity_panel,
weights = list(nb = nb, listw = listw),
global = list(I_obs = I_obs, p_perm = p_perm, nsim = nsim),
summary = summary_tbl,
map = map
))
}
# 假设 g 为 sf（含 geometry、co2_per_1000p、urbanity）
res <- bv_lisa(urbanity_panel, x_var = "co2_per_1000p", y_var = "urbanity", k = 4, nsim = 999, alpha = 0.05)
res$map
res$summary
library(sf)
